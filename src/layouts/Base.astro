---
import '../styles/global.css';
import { parts, url } from '../lib/course';

interface Props { title: string; description?: string; activePart?: string; ns?: string; files?: { section: string; files: string[]; packages?: string[] } }
const { files, title, description = 'A free, interactive deep dive into Python: notes, runnable code, quizzes and exercises.', activePart, ns } = Astro.props;
const SITE_NAME = 'Python Under the Hood';
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
---
<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try { var t = localStorage.getItem('pdd:theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body data-ns={ns} data-files={files && (files.files.length || files.packages?.length) ? JSON.stringify(files) : undefined}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}><span class="brand-mark">py</span><span class="brand-text">Python Under the Hood</span></a>
        <nav class="site-nav" aria-label="Course parts">
          {parts.map((p) => (
            <a href={url(p.slug)} aria-label={`${p.title}: ${p.subtitle}`} aria-current={activePart === p.slug ? "page" : undefined}>
              <span class="long">{p.title}</span><span class="short" aria-hidden="true">P{p.num}</span><span class="hide-sm">: {p.subtitle}</span>
            </a>
          ))}
        </nav>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Change theme">
          <svg class="i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Python Under the Hood · see how Python really works, by running it</span>
        <span><a href={url('about')}>About</a> · <a href={url('about') + '#license'}>License (GPL-3.0)</a></span>
      </div>
    </footer>
    <script>
      import '../scripts/theme';
      import '../scripts/progress';
    </script>
  </body>
</html>
